{
  "name": "magpie-apinex-auth",
  "version": "0.1.0",
  "description": "Magpie provider plugin: APInex (one API for every model, device-code login + daily check-in)",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.mjs",
    "browser-checkin.mjs",
    "README.md",
    "locale/*.json",
    "icon.svg",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie",
    "magpie-plugin",
    "apinex",
    "provider"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yidasanqian/magpie-apinex-auth.git"
  },
  "homepage": "https://github.com/yidasanqian/magpie-apinex-auth#readme",
  "bugs": {
    "url": "https://github.com/yidasanqian/magpie-apinex-auth/issues"
  },
  "magpie": {
    "maxConcurrency": 4,
    "icon": "data:image/svg+xml;base64,"
  }
}
